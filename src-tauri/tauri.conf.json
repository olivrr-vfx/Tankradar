{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tankradar",
  "version": "../package.json",
  "identifier": "app.tankradar.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tankradar",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Navigation",
    "shortDescription": "Spritpreise, Preisverlauf & Routenplaner",
    "longDescription": "Tankradar zeigt Spritpreise in Echtzeit, Preisverläufe einzelner Tankstellen, den Durchschnitt in deiner Umgebung, die beste Tankzeit und die günstigsten Tankstopps auf deiner Route. Kostenlos und Open Source.",
    "copyright": "MIT License – Tankradar contributors",
    "homepage": "https://github.com/olivrr-vfx/tankradar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "utils" }
    }
  }
}
